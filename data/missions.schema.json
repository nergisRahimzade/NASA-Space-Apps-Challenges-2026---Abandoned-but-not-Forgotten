{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Abandoned But Not Forgotten: missions",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "date",
      "location",
      "goal",
      "payload",
      "story",
      "modelFile",
      "coordinates"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "mission": {
        "type": "string"
      },
      "body": {
        "type": "string",
        "enum": [
          "Moon",
          "Mars",
          "Deep space"
        ]
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date of the event named in dateEvent, YYYY-MM-DD (UTC)"
      },
      "location": {
        "type": "string",
        "description": "Landing or arrival site. For the Apollo rover this is where it arrived on the lunar module, not where it was parked."
      },
      "goal": {
        "type": "string",
        "description": "Why it was sent, in kid-friendly words"
      },
      "payload": {
        "type": "string",
        "description": "Main instruments or equipment it carried"
      },
      "story": {
        "type": "string",
        "description": "What it is, kid-friendly, 60 words max"
      },
      "coolFact": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "modelFile": {
        "type": "string",
        "pattern": "^models/.+\\.glb$"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        }
      },
      "verified": {
        "type": "boolean",
        "description": "true once DAT confirms every field against a source"
      },
      "dateEvent": {
        "type": "string",
        "description": "What the date means, e.g. 'landing (UTC)'. Not the same as mission end."
      },
      "coordinates": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "additionalProperties": false
          }
        ],
        "description": "Decimal degrees of the landing site (south and west negative). Use null until DAT confirms it from NSSDCA."
      }
    }
  },
  "description": "Missing values: use null (or an empty sources list), never leave a field out. The site shows 'unknown' for null."
}